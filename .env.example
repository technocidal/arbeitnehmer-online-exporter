# Environment variables for DATEV Arbeitnehmer Online downloader
# Copy this file to .env and fill in your values.
# Values starting with op:// are resolved via the 1Password CLI.

# Your DATEV login e-mail
DATEV_USERNAME=op://VAULT/DATEV/username

# Your DATEV login password
DATEV_PASSWORD=op://VAULT/DATEV/password

# 1Password item name or op:// reference for the TOTP secret
# The item name alone (e.g. "DATEV") is sufficient if the item has a TOTP field.
DATEV_OTP_REF=op://VAULT/DATEV/one-time password
